# Pluggy API credentials (server-side only)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=

# Production webhook URL used by scripts/register-pluggy-webhook.mjs
PLUGGY_WEBHOOK_URL=https://core-finance-nine.vercel.app/api/webhooks/pluggy

# Optional Vercel Deployment Protection bypass for webhook delivery
VERCEL_AUTOMATION_BYPASS_SECRET=

# Shared secret sent in the custom header configured for the Pluggy webhook
PLUGGY_WEBHOOK_SECRET=

# Supabase server-side credentials
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Independent HMAC key for API rate-limit IP pseudonymization (at least 32 random bytes)
API_RATE_LIMIT_HMAC_SECRET=

# Optional Gmail SMTP failure alerts (Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
