# Plaid Sandbox API credentials (server-side only)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_ACCESS_TOKEN=

# Pluggy API credentials (server-side only)
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_ITEM_ID=

# Separate Supabase Edge Function dio-bank-mcp (configure in Supabase secrets, not in the frontend)
MCP_TOKEN=

# Shared secret sent in the custom header configured for the Pluggy webhook
PLUGGY_WEBHOOK_SECRET=

# Supabase server-side credentials
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional Gmail SMTP failure alerts (Google App Password)
GMAIL_USER=
GMAIL_APP_PASSWORD=
ALERT_EMAIL_TO=
